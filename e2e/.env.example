# Copy to .env and fill in. .env is gitignored (it holds real credentials).

# Ports below were read off the running SUT, not assumed:
#   backend        node server.js          -> 3000  (setup_guide.md step 1.5)
#   frontend-web   npm run dev (vite)      -> 5173  (FR-01, FR-11)
#   frontend-admin npm run dev (vite)      -> 5174  (FR-13; strictPort in its vite.config.js)

# EShop SUT front-end base URL - the customer web app (FR-01 register, FR-11 /profile)
BASE_URL=http://localhost:5173

# EShop SUT admin app base URL (FR-13 dashboard)
ADMIN_URL=http://localhost:5174

# EShop SUT API base URL (used for data setup / teardown)
API_URL=http://localhost:3000

# Student identity stamped into every HTML report ("Run by: {StudentID}") - do not change
STUDENT_ID=23127184
STUDENT_NAME=Le Pham Kieu Duyen

# Accounts used by the suite. Create these manually in the SUT before running.
# NEVER commit real passwords - keep them here in .env only.
USER_EMAIL=
USER_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The SUT's own JWT signing key (see backend/server.js). Only FR-13 API-07 needs it,
# to mint a correctly-signed but expired token. Copy the real value into .env.
SUT_JWT_SECRET=
